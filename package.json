{
  "name": "@bentoguard/protocol-sdk",
  "version": "0.3.0",
  "description": "Bento Stellar SDK for AI Agents",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "jest",
    "docs:llms": "ts-node scripts/build-llms.ts",
    "docs:check": "ts-node scripts/check-snippets.ts",
    "fmt": "prettier --write \"src/**/*.ts\"",
    "prepare": "husky",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "changeset version && npm publish"
  },
  "keywords": [
    "bento",
    "guard",
    "ai",
    "agent",
    "protocol",
    "crypto",
    "stellar"
  ],
  "author": "Bento Team",
  "license": "MIT",
  "dependencies": {
    "@changesets/cli": "^2.31.0",
    "axios": "^1.18.1",
    "dotenv": "^17.4.2"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^26.1.1",
    "eslint": "^10.6.0",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "lint-staged": "^17.1.1",
    "prettier": "^3.9.4",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  },
  "lint-staged": {
    "src/**/*.ts": [
      "prettier --write"
    ]
  }
